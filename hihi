<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blueberry.syth - Trang Cá Nhân</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Quicksand for maximum cuteness -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pastel: {
                            blue: '#a0c4ff',
                            lightBlue: '#d0e1ff',
                            deepBlue: '#3a86ff',
                            softBg: '#eef4ff',
                            cardBg: 'rgba(255, 255, 255, 0.85)',
                            text: '#2b3a4a'
                        }
                    },
                    fontFamily: {
                        sans: ['Quicksand', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Animated Soft Sky Background with Floating Clouds */
        body {
            background: linear-gradient(135deg, #cbe3eb 0%, #dbe9f6 40%, #eef4ff 100%);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
            font-family: 'Quicksand', sans-serif;
            color: #2c3e50;
        }

        /* Glassmorphism cute Card */
        .cute-card {
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 3px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 15px 35px rgba(58, 134, 255, 0.12);
        }

        /* Inner container styling */
        .cute-inner {
            background: rgba(238, 244, 255, 0.7);
            border: 2px solid rgba(160, 196, 255, 0.4);
        }

        /* Floating Cloud Animation */
        .cloud {
            position: absolute;
            background: rgba(255, 255, 255, 0.6);
            border-radius: 50px;
            z-index: 0;
            pointer-events: none;
            animation: floatClouds 25s linear infinite;
        }

        @keyframes floatClouds {
            0% { transform: translateX(-150px); }
            100% { transform: translateX(100vw); }
        }

        /* Spinning Music Disk Effect */
        .disk-spin {
            animation: spin 10s linear infinite;
        }
        .disk-paused {
            animation-play-state: paused;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Range Slider Styling */
        input[type=range] {
            -webkit-appearance: none;
            background: #d0e1ff;
            border-radius: 10px;
            height: 6px;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 14px;
            width: 14px;
            border-radius: 50%;
            background: #3a86ff;
            cursor: pointer;
            box-shadow: 0 0 5px rgba(58, 134, 255, 0.4);
            transition: transform 0.2s;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
        }

        /* Cute pulse glow */
        .blue-glow {
            box-shadow: 0 0 20px rgba(160, 196, 255, 0.8);
        }
    </style>
</head>
<body class="flex flex-col items-center justify-between p-4 sm:p-6 relative">

    <div class="cloud w-32 h-10 top-10 opacity-70" style="animation-delay: 0s;"></div>
    <div class="cloud w-48 h-14 top-40 opacity-50" style="animation-delay: -10s;"></div>
    <div class="cloud w-40 h-12 top-2/3 opacity-60" style="animation-delay: -5s;"></div>

    <header class="w-full max-w-md mb-4 flex justify-between items-center text-xs font-semibold text-sky-800 z-10 px-2">
        <span class="flex items-center gap-1.5 bg-white/80 px-3.5 py-1.5 rounded-full border border-sky-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping"></span>
            ☁️ Welcome to my space
        </span>
        <div class="flex items-center gap-1.5 bg-white/80 px-3.5 py-1.5 rounded-full border border-sky-200 shadow-sm">
            <i class="fa-solid fa-heart text-sky-400"></i>
            
        </div>
    </header>

    <main class="w-full max-w-md cute-card rounded-3xl p-6 sm:p-8 flex flex-col items-center z-10 relative overflow-hidden transition-all">
        
        <!-- Cute Cloud & Star Badges -->
        <div class="absolute -top-3 -right-3 text-3xl opacity-80">✨</div>
        <div class="absolute -bottom-2 -left-2 text-3xl opacity-80">☁️</div>

        <div class="relative group mt-2 mb-3">
            <div class="absolute -inset-1.5 bg-gradient-to-r from-sky-300 to-indigo-300 rounded-full blur-md opacity-75 group-hover:opacity-100 transition duration-300"></div>
            <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1 bg-white border-4 border-sky-200 shadow-inner">
                <img id="avatarImg" 
                     src="https://cdn.phototourl.com/member/2026-10-14-739552d8-0d13-4a6e-b205-a70a046e49ee.jpg" 
                     alt="Avatar" 
                     class="w-full h-full object-cover rounded-full"
                     onerror="this.src='https://placehold.co/150x150/d0e1ff/2b3a4a?text=Cute+Me'">
            </div>
            <!-- Cute bow icon badge -->
            <div class="absolute bottom-0 right-1 bg-sky-400 text-white w-7 h-7 rounded-full flex items-center justify-center text-xs shadow-md border-2 border-white">
                🎀
            </div>
        </div>

        <!-- Name & Cute Tagline -->
        <div class="flex items-center gap-1.5 mb-1">
            <h1 class="text-2xl font-bold text-sky-900 tracking-wide">Bích Huệ</h1>
            <span class="text-sky-500 text-lg" title="Đã xác minh cute">
                <i class="fa-solid fa-circle-check"></i>
            </span>
        </div>

        <p class="text-sky-700/80 text-sm text-center mb-5 font-medium leading-relaxed">
            To be cringe is to be free <br>
            <span class="text-xs bg-sky-100 text-sky-600 px-2.5 py-0.5 rounded-full inline-block mt-1 font-semibold">
            
            </span>
        </p>

        <div class="flex flex-wrap justify-center gap-3 mb-6 w-full">
            <a href="https://www.facebook.com/bichhueowo/" target="_blank" class="w-11 h-11 rounded-2xl cute-inner flex items-center justify-center text-sky-600 hover:bg-sky-400 hover:text-white hover:scale-110 transition-all shadow-sm">
                <i class="fa-brands fa-facebook-f text-lg"></i>
            </a>
            <a href="https://instagram.com" target="_blank" class="w-11 h-11 rounded-2xl cute-inner flex items-center justify-center text-sky-600 hover:bg-sky-400 hover:text-white hover:scale-110 transition-all shadow-sm">
                <i class="fa-brands fa-instagram text-lg"></i>
            </a>
            <a href="https://tiktok.com" target="_blank" class="w-11 h-11 rounded-2xl cute-inner flex items-center justify-center text-sky-600 hover:bg-sky-400 hover:text-white hover:scale-110 transition-all shadow-sm">
                <i class="fa-brands fa-tiktok text-lg"></i>
        
         
            </a>
        </div>

        <div class="w-full cute-inner rounded-2xl p-4 relative overflow-hidden shadow-sm">
            <audio id="audioPlayer" preload="metadata"></audio>

            <div class="flex items-center gap-3.5 mb-3">
                <!-- Music Disk / Cover Art -->
                <div class="relative w-14 h-14 flex-shrink-0">
                    <img id="musicThumb" 
                         src="https://cdn.phototourl.com/member/2026-10-14-739552d8-0d13-4a6e-b205-a70a046e49ee.jpg" 
                         alt="Cover" 
                         class="w-full h-full object-cover rounded-full border-2 border-sky-300 disk-spin disk-paused shadow">
                    <div class="hidden"></div>
                </div>

                <!-- Song Information -->
                <div class="flex-grow overflow-hidden">
                    <h4 id="songTitle" class="text-sm font-bold text-sky-900 truncate">Gửi Lấy Làm Gì</h4>
                    <p id="songArtist" class="text-xs text-sky-600 font-medium truncate">Monstar</p>
                </div>

                <!-- Playback Controls -->
                <div class="flex items-center gap-1.5">
                    <button id="prevBtn" class="p-2 text-sky-500 hover:text-sky-700 transition">
                        <i class="fa-solid fa-backward-step"></i>
                    </button>
                    <button id="playBtn" class="w-10 h-10 rounded-full bg-sky-400 hover:bg-sky-500 text-white flex items-center justify-center shadow-md transition transform active:scale-95">
                        <i id="playIcon" class="fa-solid fa-play ml-0.5"></i>
                    </button>
                    <button id="nextBtn" class="p-2 text-sky-500 hover:text-sky-700 transition">
                        <i class="fa-solid fa-forward-step"></i>
                    </button>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="space-y-1">
                <input type="range" id="progressBar" value="0" min="0" max="100" class="w-full cursor-pointer">
                <div class="flex justify-between text-[11px] text-sky-600 font-semibold px-0.5">
                    <span id="currentTime">0:00</span>
                    <span id="durationTime">0:00</span>
                </div>
            </div>

            <!-- Playlist Expand Toggle -->
            <div class="mt-2.5 pt-2 border-t border-sky-200/60 flex items-center justify-between text-xs font-semibold">
                <button id="togglePlaylist" class="text-sky-600 hover:text-sky-800 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-list-ul"></i>
                    <span>Góc Âm Nhạc (<span id="playlistCount">3</span>)</span>
                </button>
                <div class="flex items-center gap-1.5">
                    <i class="fa-solid fa-volume-high text-sky-500 text-xs"></i>
                    <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="0.8" class="w-14">
                </div>
            </div>

            <!-- Hidden Playlist Dropdown -->
            <div id="playlistContainer" class="hidden mt-2 max-h-32 overflow-y-auto space-y-1 text-xs pt-1 border-t border-sky-200/40">
                <!-- Javascript will inject list here -->
            </div>
        </div>

        <a href="https://m.me/" target="_blank" class="w-full mt-4 py-3 px-4 bg-sky-400 hover:bg-sky-500 text-white font-bold text-sm rounded-2xl shadow-md flex items-center justify-center gap-2 transition duration-200 transform active:scale-98">
            <i class="fa-regular fa-paper-plane"></i>
            <span>Nhắn tin cho mình nè 💌</span>
        </a>
    </main>

    <footer class="mt-6 text-center text-xs font-medium text-sky-700/70 z-10">
        <p>Made with 🩵 @bihu • eheh</p>
    </footer>

    <script>
        // 1. Playlist Data (Thay nhạc & ảnh tại đây)
        const playlist = [
            {
                title: "helo e phẻ hok",
                artist: "Dfoxie37",
                src: "https://files.catbox.moe/zrioyq.mp3",
                cover:"https://cdn.phototourl.com/member/2026-10-14-c7837a12-5b2e-479f-a9a6-6c26d8c5bc8f.jpg"
            },
        
        ];

        // 2. Selectors
        const audio = document.getElementById('audioPlayer');
        const playBtn = document.getElementById('playBtn');
        const playIcon = document.getElementById('playIcon');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const songTitle = document.getElementById('songTitle');
        const songArtist = document.getElementById('songArtist');
        const musicThumb = document.getElementById('musicThumb');
        const progressBar = document.getElementById('progressBar');
        const currentTimeEl = document.getElementById('currentTime');
        const durationTimeEl = document.getElementById('durationTime');
        const volumeSlider = document.getElementById('volumeSlider');
        const togglePlaylistBtn = document.getElementById('togglePlaylist');
        const playlistContainer = document.getElementById('playlistContainer');
        const playlistCount = document.getElementById('playlistCount');

        let currentTrackIndex = 0;
        let isPlaying = false;

        // 3. Functions
        function loadTrack(index) {
            const track = playlist[index];
            songTitle.textContent = track.title;
            songArtist.textContent = track.artist;
            musicThumb.src = track.cover;
            audio.src = track.src;
            updatePlaylistUI();
        }

        function togglePlay() {
            if (isPlaying) {
                pauseTrack();
            } else {
                playTrack();
            }
        }

        function playTrack() {
            isPlaying = true;
            const playPromise = audio.play();
            if (playPromise !== undefined) {
                playPromise.then(() => {
                    playIcon.classList.remove('fa-play');
                    playIcon.classList.add('fa-pause');
                    musicThumb.classList.remove('disk-paused');
                }).catch(err => {
                    if (err.name !== 'AbortError') console.warn(err);
                    isPlaying = false;
                    playIcon.classList.remove('fa-pause');
                    playIcon.classList.add('fa-play');
                    musicThumb.classList.add('disk-paused');
                });
            }
        }

        function pauseTrack() {
            isPlaying = false;
            audio.pause();
            playIcon.classList.remove('fa-pause');
            playIcon.classList.add('fa-play');
            musicThumb.classList.add('disk-paused');
        }

        function nextTrack() {
            currentTrackIndex = (currentTrackIndex + 1) % playlist.length;
            loadTrack(currentTrackIndex);
            if (isPlaying) playTrack();
        }

        function prevTrack() {
            currentTrackIndex = (currentTrackIndex - 1 + playlist.length) % playlist.length;
            loadTrack(currentTrackIndex);
            if (isPlaying) playTrack();
        }

        function formatTime(seconds) {
            if (isNaN(seconds)) return "0:00";
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }

        function renderPlaylist() {
            playlistCount.textContent = playlist.length;
            playlistContainer.innerHTML = '';
            
            playlist.forEach((track, idx) => {
                const item = document.createElement('div');
                item.className = `p-2 rounded-xl flex items-center justify-between cursor-pointer hover:bg-sky-200/50 transition ${idx === currentTrackIndex ? 'bg-sky-200/80 text-sky-900 font-bold' : 'text-sky-700'}`;
                item.innerHTML = `
                    <div class="flex items-center gap-2 truncate">
                        <i class="fa-solid ${idx === currentTrackIndex ? 'fa-compact-disc animate-spin text-sky-600' : 'fa-music text-xs opacity-60'}"></i>
                        <span class="truncate">${track.title} - <span class="opacity-75 font-normal">${track.artist}</span></span>
                    </div>
                `;
                item.addEventListener('click', () => {
                    currentTrackIndex = idx;
                    loadTrack(currentTrackIndex);
                    playTrack();
                });
                playlistContainer.appendChild(item);
            });
        }

        function updatePlaylistUI() {
            renderPlaylist();
        }

        // 4. Listeners
        playBtn.addEventListener('click', togglePlay);
        nextBtn.addEventListener('click', nextTrack);
        prevBtn.addEventListener('click', prevTrack);

        audio.addEventListener('timeupdate', () => {
            if (audio.duration) {
                const progressPercent = (audio.currentTime / audio.duration) * 100;
                progressBar.value = progressPercent;
                currentTimeEl.textContent = formatTime(audio.currentTime);
                durationTimeEl.textContent = formatTime(audio.duration);
            }
        });

        progressBar.addEventListener('input', () => {
            if (audio.duration) {
                audio.currentTime = (progressBar.value / 100) * audio.duration;
            }
        });

        volumeSlider.addEventListener('input', (e) => {
            audio.volume = e.target.value;
        });

        audio.addEventListener('ended', nextTrack);

        togglePlaylistBtn.addEventListener('click', () => {
            playlistContainer.classList.toggle('hidden');
        });

        // 5. Visitor Counter
        function initVisitorCounter() {
            let count = localStorage.getItem('cute_visitor_count') || 1240;
            count = parseInt(count) + 1;
            localStorage.setItem('cute_visitor_count', count);
            document.getElementById('visitorCount').textContent = count.toLocaleString('vi-VN');
        }

        window.onload = () => {
            loadTrack(currentTrackIndex);
            initVisitorCounter();
        };
    </script>
</body>
</html>
